{
  "name": "glossy-xr",
  "version": "0.2.0",
  "description": "Glossy, rebuilt: spatially anchored, multi-user voice annotation for WebXR (successor to the 2016 BuzzFeed Open Lab WebVR prototype)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  }
}
